{
  "name": "udigity-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E, accessibility, navy dark-mode and visual checks for the Udigity Management System (QA Lead). Not a root workspace.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:journeys": "cross-env E2E_JOURNEYS=1 playwright test tests/journeys",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^7.0.3",
    "otplib": "^12.0.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.2"
  }
}
