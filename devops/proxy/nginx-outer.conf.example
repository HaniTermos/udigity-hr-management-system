# Outer proxy = nginx installed on the host (a vhost next to the other sites). Copy to /etc/nginx/sites-available/hrsystem.udigity.com
# (or conf.d), enable it, then issue the certificate with the tool this server already uses, for example:
#     sudo certbot --nginx -d hrsystem.udigity.com -m <owner e-mail> --agree-tos      # edits this file, adds the 443 block
# The 443 block below is what certbot --nginx would create; if you issue with `certbot certonly --webroot -w /var/www/certbot`
# instead, use the file as it is. NEVER use `certbot --standalone` and never stop this nginx: it serves the other sites.
# The Udigity stack listens on 127.0.0.1:8080 (HTTP_PORT in /opt/udigity/.env) and is not reachable from outside.

server {
  listen 80;
  listen [::]:80;
  server_name hrsystem.udigity.com;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;                       # nginx >= 1.25.1; on older versions write: listen 443 ssl http2;
  server_name hrsystem.udigity.com;

  ssl_certificate     /etc/letsencrypt/live/hrsystem.udigity.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hrsystem.udigity.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 10m;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;                            # must stay hrsystem.udigity.com: the inner nginx drops other hosts
    # OVERWRITE (not append) with the TCP peer: if this host sits behind Cloudflare or another CDN, see the note at the end.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    # Do not add security headers here: the inner nginx and the app already send them (a second HSTS/CSP would be a duplicate).
  }
}

# Behind Cloudflare (orange cloud): $remote_addr is a Cloudflare address. Install the realip module config for Cloudflare's published ranges in THIS
# nginx (set_real_ip_from <each range>; real_ip_header CF-Connecting-IP;) so the line above passes the visitor's address on.
