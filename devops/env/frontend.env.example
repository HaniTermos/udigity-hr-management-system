# Frontend (Next.js) runtime environment. Copy to devops/env/frontend.env. Never commit the filled copy.
# NEXT_PUBLIC_* values are inlined at BUILD time: pass them as build args (devops/frontend.Dockerfile),
# setting them here only affects server-side code.
NODE_ENV=production
INTERNAL_API_URL=http://backend:5000
# Must match the backend cookie names (production defaults shown).
SESSION_COOKIE_NAME=__Host-udigity_session
NEXT_PUBLIC_CSRF_COOKIE_NAME=__Host-udigity_csrf
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12
# Dev personas are ignored in production builds; keep off.
NEXT_PUBLIC_ENABLE_DEV_PERSONAS=false
