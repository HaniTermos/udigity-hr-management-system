# Frontend (Next.js) runtime environment. Copy to devops/env/frontend.env. Never commit the filled copy.
# NEXT_PUBLIC_* values are inlined into the JavaScript at BUILD time. Setting them HERE has NO effect in the browser
# (G-15). To change them, put NEXT_PUBLIC_CSRF_COOKIE_NAME / NEXT_PUBLIC_PASSWORD_MIN_LENGTH in /opt/udigity/.env
# (see compose.env.example) and rebuild the frontend image; keep them equal to CSRF_COOKIE_NAME / PASSWORD_MIN_LENGTH in
# backend.env. The lines below only document the defaults and are compared by devops/scripts/check-env.sh.
NODE_ENV=production
INTERNAL_API_URL=http://backend:5000
# Must match the backend cookie names (production defaults shown).
SESSION_COOKIE_NAME=__Host-udigity_session
NEXT_PUBLIC_CSRF_COOKIE_NAME=__Host-udigity_csrf
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12
# Dev personas are ignored in production builds; keep off.
NEXT_PUBLIC_ENABLE_DEV_PERSONAS=false
