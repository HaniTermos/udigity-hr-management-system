# PostgreSQL container (compose service "db"). Copy to devops/env/postgres.env, fill in, chmod 600. Never commit.
#
# Three database roles for the application (gap 8, DEV-R5, migration 012) plus the backup role (backup.env):
#   POSTGRES_USER   bootstrap SUPERUSER. Used by the init scripts, the nightly pg_dump and hands-on admin inside the db
#                   container. Nothing in the application, the migrations or backend.env/migrate.env refers to it.
#   OWNER_DB_USER   NOSUPERUSER schema owner. Owns the database and the public schema; the migrate job connects as this role
#                   (devops/env/migrate.env). Created by devops/postgres/init/05-owner-role.sh.
#   APP_DB_USER     limited login role the API and worker connect as (DATABASE_URL in backend.env). Created by
#                   devops/postgres/init/10-app-role.sh on the first start of an empty data directory.
# All three passwords must be different (plus BACKUP_DB_PASSWORD in backup.env). Generate each: openssl rand -base64 32 | tr -d '/+='
POSTGRES_DB=udigity
POSTGRES_USER=udigity_admin
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8
OWNER_DB_USER=udigity_owner
OWNER_DB_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_DB_USER=udigity_api
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
