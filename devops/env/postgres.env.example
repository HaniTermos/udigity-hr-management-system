# PostgreSQL container (compose service "db"). Copy to devops/env/postgres.env, fill in, chmod 600. Never commit.
#
# Two database roles (DEV-R5, migration 012):
#   POSTGRES_USER  owner + superuser. Runs migrations (devops/env/migrate.env) and backups. The app never uses it.
#   APP_DB_USER    limited login role the API and worker connect as (DATABASE_URL in backend.env). Created by
#                  devops/postgres/init/10-app-role.sh on the first start of an empty data directory.
# The two passwords must be different. Generate each: openssl rand -base64 32 | tr -d '/+='
POSTGRES_DB=udigity
POSTGRES_USER=udigity_owner
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8
APP_DB_USER=udigity_api
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
