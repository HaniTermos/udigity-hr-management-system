# Backend (Express API + worker) production environment.
# Copy to devops/env/backend.env on the server, fill in, chmod 600, then validate:
#     devops/scripts/check-env.sh
# NEVER commit the filled copy. The API and the worker read this same file.
#
# Legend (devops/scripts/check-env.sh enforces the REQUIRED ones):
#   [REQUIRED]  production refuses to start, or the feature fails closed, without it
#   [OPTIONAL]  safe default shown; uncommented lines are the recommended production values
# Commented lines ("# KEY=value") show the built-in default; uncomment to override.
# Every value labelled "Demonstration alternative - not approved" is a working default the Owner delegated
# (docs/policy-defaults.md); the only explicitly approved rule is "Accepted keeps reservation".
# An unset NODE_ENV is treated as production (strict mode).

# --- Runtime ---------------------------------------------------------------------------------------------
# [REQUIRED] must be exactly "production" on the VPS
NODE_ENV=production
# [OPTIONAL] default 5000 (compose healthchecks and nginx assume 5000)
PORT=5000
# [REQUIRED] D2: the reverse proxy (nginx) address(es) whose X-Forwarded-For entry is trusted for req.ip, as a
# comma list of IPs / CIDRs (or the Express presets loopback, linklocal, uniquelocal). Use the nginx container's
# compose network, e.g. the subnet shown by: docker network inspect <project>_default --format '{{(index .IPAM.Config 0).Subnet}}'
# Production /readyz answers 503 until it is set. The office-IP check (ADR-016) relies on it.
TRUSTED_PROXY_CIDRS=
# [LEGACY] development/test only: TRUST_PROXY=true trusts one hop when TRUSTED_PROXY_CIDRS is empty. Ignored in production.
TRUST_PROXY=true

# --- Database (compose service "db") --------------------------------------------------------------------
# [REQUIRED] DATABASE_URL, or all of DB_HOST + DB_NAME + DB_USER + DB_PASSWORD.
# The API and worker connect as the LIMITED role APP_DB_USER (postgres.env): never as POSTGRES_USER (superuser/owner).
# Password must equal APP_DB_PASSWORD in devops/env/postgres.env. URL-encode special characters.
# Generate the password: openssl rand -base64 32 | tr -d '/+='
DATABASE_URL=postgres://udigity_api:CHANGE_ME_APP_PASSWORD@db:5432/udigity
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=udigity
# DB_USER=udigity_api
# DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Do NOT set MIGRATION_DATABASE_URL here: it lives in migrate.env and is loaded only by the "migrate" job.

# --- Session / cookies / origin --------------------------------------------------------------------------
# [REQUIRED] >= 32 random characters, not the example value.  Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
# [REQUIRED] public origin(s), comma-separated, e.g. https://app.example.com. Must match nginx server_name and the TLS cert.
APP_ORIGIN=https://app.example.com
# [REQUIRED] base URL used in email links (falls back to the first APP_ORIGIN, but set it explicitly).
# Must be a bare https:// origin (no path, query or credentials); the API and worker refuse to start otherwise.
PUBLIC_APP_URL=https://app.example.com
# [OPTIONAL] default = APP_ORIGIN (first entry)
# CORS_ORIGIN=https://app.example.com
# [OPTIONAL] production defaults shown; the frontend env must use the same cookie names.
# SESSION_COOKIE_NAME=__Host-udigity_session
# CSRF_COOKIE_NAME=__Host-udigity_csrf
# [OPTIONAL] requests with neither Origin nor Referer: rejected in production (default false). Keep false.
# ALLOW_MISSING_ORIGIN=false
# [OPTIONAL] dev only; production is always Secure
# COOKIE_SECURE=true

# --- Sessions: IMPL-SESSION, Demonstration alternative - not approved -------------------------------------
# [OPTIONAL] defaults: idle 120 min, absolute 12 h, pending-2FA 10 min
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
SESSION_PENDING_2FA_MINUTES=10

# [OPTIONAL] alias of SESSION_ABSOLUTE_HOURS (the latter wins)
# SESSION_MAX_AGE_HOURS=12

# --- R-11, Demonstration alternative - not approved: R11-a = a pending Owner session can do nothing ------
# [OPTIONAL] R11-a | R11-b (default R11-a)
OWNER_PENDING_2FA_SCOPE=R11-a

# --- IMPL-LOCKOUT, Demonstration alternative - not approved ------------------------------------------------
# [OPTIONAL] defaults 5 failures / 15 min window / 15 min lock; per-IP auth limit 20 per 15 min
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- IMPL-PASSWORD, Demonstration alternative - not approved -----------------------------------------------
# [OPTIONAL] defaults: min length 12, reset link valid 60 min
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TTL_MINUTES=30

# [OPTIONAL] bcrypt cost for passwords (default 12) and recovery codes (default 10); production minimum applies
# PASSWORD_BCRYPT_ROUNDS=12
# RECOVERY_CODE_BCRYPT_ROUNDS=10

# --- 2FA (TOTP method is a Demonstration alternative - not approved) ----------------------------------------
# [OPTIONAL] authenticator-app issuer name (default Udigity)
TOTP_ISSUER=Udigity
# [REQUIRED] AES-256-GCM key for TOTP secrets at rest: 32 random bytes as 64 hex chars or base64.
# Generate: openssl rand -hex 32   (store a copy separately from the DB backups; losing it locks every user out of 2FA)
TOTP_ENC_KEY=CHANGE_ME
# [OPTIONAL] id stored next to each ciphertext (default k1); change it only when rotating the key
TOTP_ENC_KEY_ID=k1
# [OPTIONAL] retired keys for decrypting old data during rotation: id:key,id:key
# TOTP_ENC_PREVIOUS_KEYS=k0:<old key>

# --- Email (nodemailer). DEFAULT = NO REAL EMAIL ------------------------------------------------------------
# [OPTIONAL] With SMTP_HOST empty (or EMAIL_TRANSPORT=log) production sends NOTHING: the worker logs a start-up ERROR
# and records every email as failed ("email transport not configured") on the Delivery monitor. Links are never logged.
# If SMTP_HOST is set but EMAIL_ALLOW_REAL_SEND is not exactly "true", the worker REFUSES TO START.
# Turning real email on needs the Owner's go-ahead: devops/DEPLOY.md section 10.
SMTP_HOST=
# 587 (STARTTLS, SMTP_SECURE=false) or 465 (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# plain address, no display name (alias EMAIL_FROM, used only when SMTP_FROM is empty). Default no-reply@udigity.invalid
SMTP_FROM=no-reply@example.com
# log | smtp (default: smtp when SMTP_HOST is set, otherwise log)
EMAIL_TRANSPORT=
EMAIL_ALLOW_REAL_SEND=false
# [OPTIONAL] Operator failure alerts (API 500s, dead jobs/events, process crashes), comma-separated.
# One email per kind per 15 minutes, sent by the worker through the transport above. Empty = not emailed
# (alerts stay in the ops_alerts table and the logs). Use an approved operator address.
ALERT_EMAIL_TO=
# (EMAIL_LOG_LINKS=true prints full links from the log transport in NODE_ENV=development only; ignored in production.)

# --- Company values (Owner settings, SCR-OWN-011). These env values are first-boot defaults; a value the
# --- Owner saves wins. Aliases COMPANY_TIMEZONE / OFFICE_IP_ALLOWLIST / ATTENDANCE_OFFICE_MODE are used only
# --- when the POLICY_* name is empty.
# [REQUIRED] IANA zone (BL-16). Attendance and reports fail closed without a timezone.
# REQUIRED — company-confirmed value (VAL-TZ; proposed Asia/Beirut, not confirmed). Attendance enforcement still starts
# only after the Owner saves the complete attendance settings (working days, start, timezone, office IPs, holidays).
POLICY_COMPANY_TIMEZONE=
# /readyz resolves the zone like every module (UDI-7): Owner-saved value, else POLICY_COMPANY_TIMEZONE, else the alias.
# COMPANY_TIMEZONE=
# [OPTIONAL] office static public IP(s)/CIDRs, comma-separated (D2, VAL-IP). A pre-fill suggestion for the Owner's
# settings form only; attendance stays "Not configured" until the Owner saves the office IP list.
POLICY_ATTENDANCE_OFFICE_IPS=
# Aliases used only when the POLICY_* name above is empty: COMPANY_TIMEZONE, OFFICE_IP_ALLOWLIST, ATTENDANCE_OFFICE_MODE
# OFFICE_IP_ALLOWLIST=
# ATTENDANCE_OFFICE_MODE=
# EMAIL_FROM=
# [OPTIONAL] D2: ip is the only accepted value (no allow-all, no geolocation); any other value fails at startup
POLICY_ATTENDANCE_VERIFICATION_MODE=ip

# --- Policy settings and flags, all Demonstration alternative - not approved (shared/flags.ts) ----------------
# [OPTIONAL] Commented lines show the built-in default. Includes the Increment 6 worker-job and report keys:
#   POLICY_RETENTION_* (retention sweeps run by the worker), POLICY_NOTIFICATIONS_* (reminders, email retry),
#   POLICY_BACKUP_RETENTION_* (informational; the backup script reads KEEP_* from backup.env).
# POLICY_AUTH_RECOVERY_CODE_COUNT=10   # OQ-12/IMPL-2FA; server config
# POLICY_BUSINESS_DEFAULT_COUNTRY_CODE=   # B2/VAL-CC; Owner setting (first-boot default); NEEDS VALUE (empty = Not configured)
# POLICY_DEALS_DEFAULT_CURRENCY=   # DEC-018/VAL-CURRENCY; Owner setting (first-boot default); NEEDS VALUE (empty = Not configured)
# POLICY_ATTENDANCE_WORKING_DAYS=MON,TUE,WED,THU,FRI   # D1; pre-fill suggestion only (never activates enforcement)
# POLICY_ATTENDANCE_SHIFT_START=09:00   # D1; pre-fill suggestion only; shift end is derived (start + 9 h)
# POLICY_ATTENDANCE_GRACE_MINUTES=10   # D1 (approved 10 min); late strictly after start + grace
# POLICY_ATTENDANCE_HOLIDAYS=   # D1/VAL-HOLIDAYS; pre-fill suggestion only; the Owner confirms the holiday list in Settings
# POLICY_ATTENDANCE_REMOTE_SELF_REQUEST=false   # DEC-010; feature flag
# POLICY_ATTENDANCE_EMPLOYEE_REQUESTS=true   # DEC-011; feature flag
# POLICY_ATTENDANCE_FAILED_CHECKOUT=provisional   # D5 (approved): provisional is the only accepted value
# POLICY_ATTENDANCE_BREAKS_ENABLED=false   # fixed v1 scope "no break tracking": break routes 404 while false
# POLICY_ATTENDANCE_MISSING_CHECKOUT_FLAG_HOURS=6   # D5; Owner setting (first-boot default)
# POLICY_WORK_AUTOFILL_QUEUE_CAP=40   # D8; Owner setting (first-boot default); queue cap, not a quota
# POLICY_VISIBILITY_TIMER_BASIS=creation   # D9 (approved): `creation` is the only accepted value (elapsed days from creation/assignment)
# POLICY_VISIBILITY_DEC002_ROWS=R1,R2,R3,R4,R5,R6   # DEC-002; server config
# POLICY_VISIBILITY_CALLBACK_GRACE_HOURS=48   # DEC-002 row 5; server config
# POLICY_VISIBILITY_COMPLETED_PROJECT_DAYS=15   # DEC-002 row 4/OI-18; server config
# POLICY_ACCESS_DATA_ENTRY_SCOPE=DE-1   # OI-02; feature flag
# POLICY_ACCESS_AUDIT_OWNER_HIDDEN_READS=true   # OI-05; Owner setting (first-boot default)
# POLICY_DUPLICATES_NAME_SIMILARITY_THRESHOLD=0.6   # DEC-013; Owner setting (first-boot default)
# POLICY_SOCIAL_PLATFORMS=facebook,instagram,tiktok,linkedin,x,youtube,other   # DEC-024; Owner setting (first-boot default)
# POLICY_RESERVATION_LEASE_SECONDS=300   # DEC-004; Owner setting (first-boot default)
# POLICY_RESERVATION_HEARTBEAT_SECONDS=60   # DEC-004; Owner setting (first-boot default)
# POLICY_RESERVATION_IDLE_MINUTES=15   # DEC-004; Owner setting (first-boot default)
# POLICY_RESERVATION_IDLE_WARNING_MINUTES=13   # DEC-004; Owner setting (first-boot default)
# POLICY_RESERVATION_MAX_TOTAL_MINUTES=60   # DEC-004; Owner setting (first-boot default)
# POLICY_RESERVATION_OWNER_OVERRIDE=true   # DEC-004/B3-Q14; Owner setting (first-boot default)
# POLICY_CALLS_SAVE_AFTER_RESERVATION_LOSS=keepAttemptOnly   # B3-Q05; feature flag
# POLICY_CALLS_ACCEPTED_NOTE_MIN_LENGTH=10   # B3-Q16/OQ-01; Owner setting (first-boot default)
# POLICY_FOLLOWUPS_OVERDUE_MINUTES=60   # Overdue threshold; Owner setting (first-boot default)
# POLICY_DEALS_DEVELOPER_PRE_CLOSURE=assigned   # DEC-005; feature flag
# POLICY_DEALS_CLOSURE_MODE=ownerVerify   # DEC-006; feature flag
# POLICY_DEALS_REOPEN_TARGET=accepted_opportunity   # OQ-15; feature flag
# POLICY_DEALS_CURRENCIES=   # DEC-018; Owner setting (first-boot default); NEEDS VALUE (empty = Not configured)
# POLICY_PROJECTS_AUTO_PROVISION=true   # F2; feature flag
# POLICY_NOTIFICATIONS_IN_APP=true   # NOTIF/AR-14; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_FOLLOWUP_LEAD_MINUTES=15   # NOTIF; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_FOLLOWUP_OVERDUE_ALERT_MINUTES=60   # NOTIF; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_MEETING_LEAD_MINUTES=1440,60   # NOTIF; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_MISSING_CHECKIN_AFTER_GRACE_MINUTES=30   # NOTIF/F-05; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_MISSING_CHECKOUT_AFTER_SHIFT_MINUTES=60   # NOTIF/F-05; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_EMAIL_RETRY_SECONDS=60,600,3600   # NOTIF; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_NOTIFY_PREVIOUS_ASSIGNEE=true   # OWN-008; Owner setting (first-boot default)
# POLICY_NOTIFICATIONS_LATE_REMINDER=sendIfEventFuture   # B3-Q08; server config
# POLICY_AUDIT_EXPORT_ENABLED=false   # OQ-18; feature flag
# POLICY_RETENTION_SESSIONS_DAYS=90   # C3; server config
# POLICY_RETENTION_RESERVATIONS_DAYS=90   # C3; server config
# POLICY_RETENTION_NOTIFICATIONS_DAYS=180   # C3; server config
# POLICY_RETENTION_JOBS_DAYS=30   # C3; server config
# POLICY_RETENTION_TOKENS_DAYS=30   # C3; server config
# POLICY_RETENTION_IDEMPOTENCY_HOURS=48   # C3; server config
# POLICY_BACKUP_RETENTION_DAILY=14   # C1; server config
# POLICY_BACKUP_RETENTION_WEEKLY=8   # C1; server config
# POLICY_BACKUP_RETENTION_MONTHLY=6   # C1; server config
# POLICY_COMPANY_NAME=Udigity   # SCR-OWN-011 (FX-BE-C1); Owner setting (first-boot default)
# POLICY_FOLLOWUPS_MAX_SCHEDULE_DAYS=90   # R2-11; server config
# POLICY_ATTENDANCE_BREAK_ALLOWANCE_MINUTES=60   # ATT-BREAKS; Owner setting (first-boot default)
# POLICY_ATTENDANCE_MAX_BREAKS_PER_SESSION=10   # ATT-BREAKS; Owner setting (first-boot default)
