# Backup container (compose service "backup", devops/backup/backupd.sh). Copy to devops/env/backup.env, chmod 600.
# Never commit. Loaded by the backup service, and by the db service (BACKUP_DB_PASSWORD creates the backup role).
#
# Storage: the "backups" Docker volume on THIS server (Owner-approved exception, 2026-10-29). Losing the server or its
# disk loses the database and the backups together. Off-server copy = upgrade path (devops/DEPLOY.md section 11).

# Dedicated read-only backup role (devops/postgres/init/20-backup-role.sh). Not the owner, not the app role.
# Generate: openssl rand -base64 32 | tr -d '/+='
BACKUP_DB_USER=udigity_backup
BACKUP_DB_PASSWORD=CHANGE_ME_BACKUP_PASSWORD
BACKUP_DB_NAME=udigity

# Schedule: nightly dump at BACKUP_TIME (HH:MM, 24 h) in TZ (the company time zone, IANA name).
TZ=UTC
BACKUP_TIME=02:30
# Weekly base backup for point-in-time recovery: day of week 1=Mon .. 7=Sun; base backups kept (PITR window).
BASE_BACKUP_DAY=7
KEEP_BASE=2

# Retention of the nightly dumps (D19: 14 daily / 8 weekly / 6 monthly)
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# Growth guards (G-07). The backup service raises an ops_alerts row when the raw WAL waiting for encryption exceeds
# WAL_BACKLOG_MAX files (archive_command succeeds but encryption stalls) or when a volume is at least DISK_ALERT_PCT % full.
# The host monitor (devops/scripts/host-monitor.sh) watches the same things from outside, because this container is the
# component that is down in the worst case.
WAL_BACKLOG_MAX=20
DISK_ALERT_PCT=80

# Encryption: age. Only the PUBLIC recipient is on the server; the private identity stays offline with the Owner.
AGE_RECIPIENT=age1CHANGE_ME

# Legacy host-cron mode only (pg-backup.sh run on the host without PGHOST). Ignored by the container.
BACKUP_DIR=/var/backups/udigity
COMPOSE_FILE=/opt/udigity/docker-compose.prod.yml
DB_SERVICE=db
BACKUP_ENCRYPTION=age
GPG_RECIPIENT=
# Off-site copy with rclone (host-cron mode only; the container has no rclone and no internet route).
RCLONE_REMOTE=
