# Backup job (devops/backup/pg-backup.sh). Copy to devops/env/backup.env, chmod 600. Never commit.
# Backup storage provider: NEEDS VALUE (policy-defaults PROV-STORAGE). Any S3-compatible bucket works.
BACKUP_DIR=/var/backups/udigity
COMPOSE_FILE=/opt/udigity/docker-compose.prod.yml
DB_SERVICE=db
# Retention (C1: 14 daily / 8 weekly / 6 monthly)
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6
# Encryption: age (recommended) or gpg
BACKUP_ENCRYPTION=age
# age: PUBLIC recipient only on the server; the private identity stays offline with the Owner.
AGE_RECIPIENT=age1CHANGE_ME
# gpg alternative: recipient key id / email (public key imported on the server)
GPG_RECIPIENT=
# Optional off-site copy (rclone remote, e.g. "s3remote:udigity-backups"). Empty = local only.
RCLONE_REMOTE=
