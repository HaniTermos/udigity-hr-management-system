# Used ONLY by the compose "migrate" job (docker compose --profile tools run --rm migrate). Copy to
# devops/env/migrate.env, fill in, chmod 600. Never commit. The API and worker do NOT load this file, so the
# long-running containers never hold the owner credentials.
# user = OWNER_DB_USER, password = OWNER_DB_PASSWORD (postgres.env): the NON-superuser schema owner (gap 8), never the
# bootstrap superuser POSTGRES_USER. URL-encode special characters.
MIGRATION_DATABASE_URL=postgres://udigity_owner:CHANGE_ME_OWNER_PASSWORD@db:5432/udigity
