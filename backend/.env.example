# Server Configuration
# NODE_ENV must be set explicitly. If it is unset or unknown the server runs in strict
# production mode (fails closed): SESSION_SECRET, DB settings and APP_ORIGIN become required.
NODE_ENV=development
PORT=5000
# Public origin(s) of the app, comma-separated. Used for the Origin/Referer check on mutations
# (and for CORS in the local split dev setup). CORS_ORIGIN is still read as a fallback.
APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Base URL for links in (stubbed) emails, e.g. the password-reset link.
PUBLIC_APP_URL=http://localhost:3000
# Set to true only behind a trusted reverse proxy (so req.ip is the client IP).
TRUST_PROXY=false
# Requests with neither Origin nor Referer: default false in production, true otherwise.
# ALLOW_MISSING_ORIGIN=false

# Database Configuration (PostgreSQL 17)
# Either DATABASE_URL or the DB_* settings. Required in production.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=udigity hr management
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE

# Tests: the DB-backed API suite runs only when TEST_DATABASE_URL is set in the shell
# environment (tests never read this file) and only against that database. Use a dedicated,
# disposable database; the suite migrates, seeds and writes to it.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/udigity_test

# Security & Session
# Required in production: 64+ random characters (e.g. `openssl rand -hex 32`). Used to hash
# session/reset tokens and derive CSRF tokens. Changing it ends all sessions.
# In development, if unset, a random per-process secret is used (sessions end on restart).
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Cookie names default to udigity_session / udigity_csrf in development and
# __Host-udigity_session / __Host-udigity_csrf (Secure) in production.
# SESSION_COOKIE_NAME=udigity_session
# CSRF_COOKIE_NAME=udigity_csrf
# COOKIE_SECURE=false

# --- Policy flags --------------------------------------------------------------------------
# Every value below is a Demonstration alternative — not approved (docs/policy-defaults.md).
# The values shown are the working defaults from that file.

# IMPL-SESSION: idle 2 h, absolute 12 h, pending-2FA session 10 min.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
SESSION_PENDING_2FA_MINUTES=10

# R-11: what an Owner session may do while 2FA is pending.
# R11-a = nothing until 2FA (working default); R11-b = non-admin routes allowed.
# Admin (Owner-only) routes are always denied while pending (Confirmed).
OWNER_PENDING_2FA_SCOPE=R11-a

# IMPL-LOCKOUT: 5 failed attempts per account in 15 min -> 15 min lock; same for 2FA codes.
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15
# Per-IP rate limit on login / 2FA / password reset. policy-defaults names a per-IP limit
# but gives no number: 20 per 15 min is a placeholder (NEEDS VALUE).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# IMPL-PASSWORD: min 12 characters, no composition rules; reset link single use, 60 min.
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TTL_MINUTES=60

# IMPL-2FA: TOTP authenticator app (method not approved; Owner 2FA itself is Confirmed).
TOTP_ISSUER=Udigity
