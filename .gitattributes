# Shell scripts and Dockerfiles run inside Linux containers: always LF, even on a Windows checkout.
*.sh text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf
devops/nginx/** text eol=lf
devops/proxy/** text eol=lf
devops/env/*.example text eol=lf
docker-compose*.yml text eol=lf
.github/workflows/*.yml text eol=lf
